{
  "compilerOptions": {
    "lib": ["dom", "esnext"],
    "target": "es5",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "allowJs": false,
    "resolveJsonModule": true,
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "public",
    "postcss.config.js",
    "tailwind.config.js"
  ]
}
